---
import type { Note } from "../garden/garden";
import { notePath } from "../garden/note-file";
import StageBadge from "./StageBadge.astro";

interface Props {
  note: Note;
  /** Follow the link with its Stage badge. Off where the page sets the Stage elsewhere in the row. */
  badge?: boolean;
}

const { note, badge = true } = Astro.props;
// The badge is quieter than the link it follows: ink, not hyperref blue.
const quiet = "ml-[0.25em] text-[0.875em] text-ink decoration-ink/30";
---

<a href={notePath(note.slug)}>{note.title}</a>{badge && " "}{badge && <StageBadge stage={note.stage} class={quiet} />}
