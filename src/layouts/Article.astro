---
import Base from "./Base.astro";

// The LaTeX article every reading page shares: \maketitle (TitleBlock), the
// abstract (Abstract), and the body's typesetting with numbered sections.
// Pages put their prose in an element with class "article-body", styled in
// src/styles/global.css.

interface Props {
  title: string;
  /** Extra class for the <article>, e.g. "note". */
  class?: string;
}

const { title, class: className } = Astro.props;
---

<Base title={title}>
  {/* text-pretty: no paragraph ends on a lone word, as TeX's line breaker avoids */}
  <article class:list={["mx-auto max-w-measure pt-page-top text-pretty", className]}>
    <slot />
  </article>
</Base>
