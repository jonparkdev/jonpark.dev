---
import { coursePath } from "../garden/course";
import { loadGarden } from "../garden/garden";

interface Props {
  title: string;
}

const { title } = Astro.props;
const { courses } = loadGarden();
const here = Astro.url.pathname.replace(/\/+$/, "") || "/";
const current = (path: string) => (here === path ? "page" : undefined);
const inCourse = courses.some((course) => here === coursePath(course));
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <link rel="preload" href="/fonts/garden-modern-book.woff2" as="font" type="font/woff2" crossorigin />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-line">
      <a href="/" class="site-name" aria-current={current("/")}>jonpark.dev</a>
      <nav aria-label="Site">
        <details class:list={["courses-menu", { current: inCourse }]}>
          <summary>Courses</summary>
          <ul>
            {
              courses.map((course) => (
                <li>
                  <a href={coursePath(course)} aria-current={current(coursePath(course))}>{course.title}</a>
                </li>
              ))
            }
          </ul>
        </details>
        <a href="/about-stages" aria-current={current("/about-stages")}>About Stages</a>
      </nav>
    </header>
    <main id="main">
      <slot />
    </main>
  </body>
</html>

<style is:global>
  @font-face {
    font-family: "Garden Modern";
    src: url("/fonts/garden-modern-book.woff2") format("woff2");
    font-weight: 400;
    font-style: normal;
    font-display: swap;
  }
  @font-face {
    font-family: "Garden Modern";
    src: url("/fonts/garden-modern-book-italic.woff2") format("woff2");
    font-weight: 400;
    font-style: italic;
    font-display: swap;
  }
  @font-face {
    font-family: "Garden Modern";
    src: url("/fonts/garden-modern-bold.woff2") format("woff2");
    font-weight: 700;
    font-style: normal;
    font-display: swap;
  }
  @font-face {
    font-family: "Garden Modern";
    src: url("/fonts/garden-modern-bold-italic.woff2") format("woff2");
    font-weight: 700;
    font-style: italic;
    font-display: swap;
  }
  @font-face {
    font-family: "Garden Modern Mono";
    src: url("/fonts/garden-modern-mono-book.woff2") format("woff2");
    font-weight: 400;
    font-style: normal;
    font-display: swap;
  }

  /* The LaTeX article: a white page, black ink, hyperref blue for references,
     and a ladder of greys for everything that sits beside the text. */
  :root {
    color-scheme: light;
    --page: #ffffff;
    --ink: #111111;
    --ink-soft: #4d4d4d;
    --ink-meta: #6b6b6b;
    --rule: #111111;
    --rule-soft: #d6d6d6;
    --grain: color-mix(in srgb, var(--ink) 16%, transparent);
    --ref: #1f4e8c;
    --undefined: #8b1a1a;
    --select: #d6e2f2;
    --serif: "Garden Modern", "Latin Modern Roman", "CMU Serif", "STIX Two Text", Georgia, serif;
    --mono: "Garden Modern Mono", "Latin Modern Mono", ui-monospace, "SFMono-Regular", Menlo, monospace;
    --measure: 41rem;
    --margin-note: 13rem;
    --margin-gap: 2.5rem;
    /* The band section rules run across: the column plus a margin each side */
    --band: 76rem;
    --gutter: clamp(1rem, 4vw, 4rem);
  }

  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  html {
    background: var(--page);
    color: var(--ink);
    font-family: var(--serif);
    font-size: 100%;
    -webkit-text-size-adjust: 100%;
    text-rendering: optimizeLegibility;
  }

  body {
    margin: 0;
    font-size: 1.1875rem;
    line-height: 1.55;
    font-variant-numeric: lining-nums proportional-nums;
    font-kerning: normal;
  }

  ::selection {
    background: var(--select);
    color: var(--ink);
  }

  a {
    color: var(--ref);
    text-decoration-line: underline;
    text-decoration-thickness: 1px;
    text-decoration-color: color-mix(in srgb, var(--ref) 45%, transparent);
    text-underline-offset: 0.18em;
  }
  a:hover {
    text-decoration-color: currentColor;
    text-decoration-thickness: 2px;
  }
  :focus-visible {
    outline: 2px solid var(--ref);
    outline-offset: 2px;
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .stage-badge {
    white-space: nowrap;
  }

  .skip-link {
    position: absolute;
    left: var(--gutter);
    top: -3rem;
    background: var(--page);
    padding: 0.5rem 0.75rem;
  }
  .skip-link:focus {
    top: 0.5rem;
  }

  .site-line {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.25rem 1.75rem;
    padding: 1.5rem var(--gutter) 0;
    font-variant: small-caps;
    font-variant-numeric: lining-nums;
    letter-spacing: 0.04em;
    font-size: 1.0625rem;
  }
  .site-line a,
  .courses-menu summary {
    color: var(--ink-meta);
    text-decoration: none;
  }
  .site-line .site-name,
  .site-line a[aria-current="page"],
  .site-line a:hover,
  .courses-menu summary:hover,
  .courses-menu[open] summary,
  .courses-menu.current summary {
    color: var(--ink);
  }
  .site-line a:hover {
    text-decoration: underline;
    text-decoration-thickness: 1px;
  }
  .site-line nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.75rem;
  }

  /* Courses ▾: a plain disclosure, its list dropping below the nav */
  .courses-menu {
    position: relative;
  }
  .courses-menu summary {
    cursor: pointer;
    list-style: none;
  }
  .courses-menu summary::-webkit-details-marker {
    display: none;
  }
  .courses-menu summary::after {
    content: " ▾" / "";
  }
  .courses-menu[open] summary::after {
    content: " ▴" / "";
  }
  .courses-menu summary:hover {
    text-decoration: underline;
    text-decoration-thickness: 1px;
  }
  .courses-menu ul {
    position: absolute;
    right: 0;
    z-index: 1;
    min-width: max-content;
    margin: 0.375rem 0 0;
    padding: 0.375rem 0;
    list-style: none;
    background: var(--page);
    /* The Booktabs Rule: horizontal hairlines only, never a box */
    border-top: 0.8px solid var(--rule-soft);
    border-bottom: 0.8px solid var(--rule-soft);
  }
  .courses-menu li + li {
    margin-top: 0.25rem;
  }

  main {
    padding: 0 var(--gutter) 6rem;
  }

  /* A flow sets its children in the text column, so a section rule inside it
     can run wider than the column. Flows nest. */
  .flow > * {
    max-width: var(--measure);
    margin-inline: auto;
  }
  .flow > .flow {
    max-width: none;
  }

  /* \section, ruled: a hairline across the band, the heading set in the column */
  .flow > .section-rule,
  .flow.article-body > h2 {
    clear: both;
    box-sizing: border-box;
    max-width: none;
    width: min(100%, var(--band));
    margin-block: clamp(4rem, 10vh, 6.5rem) 1.75rem;
    padding-top: 1.25rem;
    padding-inline: max(0px, (min(100%, var(--band)) - var(--measure)) / 2);
    border-top: 0.8px solid var(--rule-soft);
  }

  /* \maketitle, shared by every page */
  .title-block {
    text-align: center;
    margin-bottom: 3rem;
  }
  .title-block h1 {
    font-size: clamp(2rem, 1.4rem + 2.4vw, 2.5rem);
    font-weight: 400;
    line-height: 1.15;
    margin: 0 0 0.875rem;
  }
  .title-block p {
    margin: 0;
    font-size: 1.0625rem;
    line-height: 1.5;
    text-wrap: balance;
  }
  .sc {
    font-variant: small-caps;
    letter-spacing: 0.03em;
  }
  .meta {
    color: var(--ink-meta);
  }

  /* \tableofcontents: ruled rows, hanging numbers, collapsible */
  .contents {
    margin-bottom: 4rem;
    border-top: 0.8px solid var(--rule-soft);
    border-bottom: 0.8px solid var(--rule-soft);
  }
  .contents summary {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    padding: 0.875rem 0;
    cursor: pointer;
    list-style: none;
    font-size: 1.0625rem;
    font-variant: small-caps;
    letter-spacing: 0.04em;
  }
  .contents summary::-webkit-details-marker {
    display: none;
  }
  .contents summary::after {
    content: "[+]" / "";
    color: var(--ink-meta);
    font-variant: normal;
    font-family: var(--mono);
    font-size: 0.875rem;
    letter-spacing: 0;
  }
  .contents details[open] > summary::after {
    content: "[\2212]" / "";
  }
  .contents details[open] > summary {
    border-bottom: 0.8px solid var(--rule-soft);
  }
  .contents ol {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .contents li + li {
    border-top: 0.8px solid var(--rule-soft);
  }
  .contents a {
    display: grid;
    grid-template-columns: 2.5rem minmax(0, 1fr);
    gap: 0.25rem;
    padding: 0.625rem 0;
    color: var(--ink);
    text-decoration: none;
    font-size: 1.0625rem;
    line-height: 1.4;
  }
  .contents a:hover .contents-label {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.18em;
  }
  .contents .contents-number {
    color: var(--ink-meta);
    font-variant-numeric: lining-nums tabular-nums;
  }
  .contents .depth-3 a {
    grid-template-columns: 2.5rem 2.5rem minmax(0, 1fr);
    font-size: 1rem;
  }
  .contents .depth-3 .contents-number {
    grid-column: 2;
  }

  h1,
  h2,
  h3,
  h4 {
    text-wrap: balance;
  }

  code,
  pre,
  kbd,
  samp {
    font-family: var(--mono);
    font-size: 0.875em;
    font-variant-numeric: lining-nums tabular-nums;
  }
</style>
