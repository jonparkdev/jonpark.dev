---
import "../styles/global.css";
import { coursePath } from "../garden/course";
import { loadGarden } from "../garden/garden";

interface Props {
  title: string;
}

const { title } = Astro.props;
const { courses } = loadGarden();

// The site line reads as running head, not as references: ink, underlined only on hover.
const navLink = "text-ink no-underline hover:underline hover:decoration-1";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <link rel="preload" href="/fonts/garden-modern-book.woff2" as="font" type="font/woff2" crossorigin />
  </head>
  <body>
    <a class="absolute -top-12 left-gutter bg-page px-3 py-2 focus:top-2" href="#main">Skip to content</a>
    <header class="flex flex-wrap items-baseline justify-between gap-x-7 gap-y-1 px-gutter pt-6 text-sub tracking-[0.04em] small-caps">
      <a href="/" class={navLink}>jonpark.dev</a>
      <nav aria-label="Site" class="flex flex-wrap gap-x-7 gap-y-1">
        {/* Courses ▾: a plain disclosure, its list dropping below the nav */}
        <details class="group relative">
          <summary
            class="cursor-pointer list-none after:content-['_▾'_/_''] hover:underline hover:decoration-1 group-open:after:content-['_▴'_/_''] [&::-webkit-details-marker]:hidden"
          >Courses</summary>
          {/* The Booktabs Rule: horizontal hairlines only, never a box */}
          <ul class="absolute right-0 z-1 mt-1.5 min-w-max space-y-1 border-y-[0.8px] border-rule bg-page py-1.5">
            {
              courses.map((course) => (
                <li>
                  <a href={coursePath(course)} class={navLink}>
                    {course.title}
                  </a>
                </li>
              ))
            }
          </ul>
        </details>
        <a href="/about-stages" class={navLink}>About Stages</a>
      </nav>
    </header>
    <main id="main" class="px-gutter pb-20">
      <slot />
    </main>
  </body>
</html>
