---
import type { GetStaticPaths } from "astro";
import Contents, { type ContentsItem } from "../components/Contents.astro";
import NoteLink from "../components/NoteLink.astro";
import { partLabel, type Course } from "../garden/course";
import { loadGarden } from "../garden/garden";
import { topicIndex } from "../garden/topic-index";
import Base from "../layouts/Base.astro";

export const getStaticPaths = (() =>
  loadGarden().courses.map((course) => ({ params: { course: course.slug }, props: { course } }))) satisfies GetStaticPaths;

interface Props {
  course: Course;
}

const { course } = Astro.props;
const index = topicIndex(course.curriculum, loadGarden().notes);

// Each Part is a ruled section; the Contents lists them by number.
const parts = index.map(({ part }, i) => {
  const numbered = /^(\d+)\s+(.+)$/.exec(part.title);
  const id = part.isTangents ? "part-tangents" : `part-${numbered ? Number(numbered[1]) : i + 1}`;
  const item: ContentsItem = part.isTangents
    ? { id, number: "🐇", label: "Tangents", depth: 2 }
    : { id, number: numbered ? String(Number(numbered[1])) : "", label: numbered ? numbered[2] : part.title, depth: 2 };
  return { entry: index[i], item };
});
---

<Base title={`${course.title} · jonpark.dev`}>
  <div class="course flow">
    <header class="title-block">
      <h1>{course.title}</h1>
      <p>{course.subtitle}</p>
    </header>

    <Contents items={parts.map(({ item }) => item)} />

    <section class="topic-index flow" aria-label="Topics">
      {index.length === 0 && <p class="empty">No Notes yet.</p>}
      {
        parts.map(({ entry: { part, topics }, item }) => (
          <section class:list={["part", "flow", { tangents: part.isTangents }]} aria-labelledby={item.id}>
            <h2 class="section-rule" id={item.id}>{partLabel(part)}</h2>
            {topics.map(({ topic, notes }) => (
              <section class="topic" id={topic.key} data-topic={topic.key}>
                <h3>{topic.title}</h3>
                <ul>
                  {notes.map((note) => (
                    <li>
                      <NoteLink note={note} />
                    </li>
                  ))}
                </ul>
              </section>
            ))}
          </section>
        ))
      }
    </section>
  </div>
</Base>

<style>
  .course {
    padding-top: clamp(2rem, 6vw, 3.5rem);
  }
  .course .title-block {
    margin-bottom: 3.5rem;
  }

  /* The outline: ruled small-caps Parts, bold Topic heads, Notes indented */
  .topic-index > .part:first-child > h2 {
    margin-top: 0;
  }
  .part h2 {
    font-size: 1.25rem;
    font-weight: 400;
    font-variant: small-caps;
    letter-spacing: 0.04em;
    line-height: 1.3;
    margin-block: clamp(3.5rem, 8vh, 5rem) 1.25rem;
    scroll-margin-top: 1.5rem;
  }
  .topic {
    scroll-margin-top: 1.5rem;
  }
  .topic + .topic {
    margin-top: 1.5rem;
  }
  .topic h3 {
    font-size: 1.1875rem;
    font-weight: 700;
    line-height: 1.3;
    margin: 0 0 0.25rem;
  }
  .topic ul {
    list-style: none;
    margin: 0;
    padding: 0 0 0 1.5em;
  }
  .topic li {
    margin-bottom: 0.25rem;
  }
  .topic-index :global(.stage-badge) {
    color: var(--ink);
    text-decoration-color: color-mix(in srgb, var(--ink) 30%, transparent);
    font-size: 0.875em;
    margin-left: 0.25em;
  }
  .empty {
    text-align: center;
  }
</style>
