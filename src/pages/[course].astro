---
import type { GetStaticPaths } from "astro";
import NoteLink from "../components/NoteLink.astro";
import TitleBlock from "../components/TitleBlock.astro";
import { partLabel, type Course } from "../garden/course";
import { loadGarden } from "../garden/garden";
import { topicIndex } from "../garden/topic-index";
import Base from "../layouts/Base.astro";

export const getStaticPaths = (() =>
  loadGarden().courses.map((course) => ({ params: { course: course.slug }, props: { course } }))) satisfies GetStaticPaths;

interface Props {
  course: Course;
}

const { course } = Astro.props;
const index = topicIndex(course.curriculum, loadGarden().notes);
---

<Base title={`${course.title} · jonpark.dev`}>
  <div class="mx-auto max-w-measure pt-page-top">
    <TitleBlock title={course.title}>
      <p class="text-sub">{course.subtitle}</p>
    </TitleBlock>

    {/* The outline: small-caps Part labels, bold Topic heads, Notes indented */}
    <section aria-label="Topics">
      {index.length === 0 && <p class="my-[1em] text-center">No Notes yet.</p>}
      {
        index.map(({ part, topics }) => (
          <section class="mb-8">
            <h2 class="mb-1 text-sub font-normal tracking-[0.04em] small-caps">{partLabel(part)}</h2>
            {topics.map(({ topic, notes }) => (
              <section id={topic.key} data-topic={topic.key}>
                <h3 class="mt-2.5 mb-0.5 text-body leading-[1.3] font-bold">{topic.title}</h3>
                <ul class="pl-[1.5em]">
                  {notes.map((note) => (
                    <li class="mb-0.75">
                      <NoteLink note={note} />
                    </li>
                  ))}
                </ul>
              </section>
            ))}
          </section>
        ))
      }
    </section>
  </div>
</Base>
