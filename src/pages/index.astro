---
import NoteLink from "../components/NoteLink.astro";
import { loadGarden } from "../garden/garden";
import { tendedDay, tendedLong } from "../garden/tended";
import Base from "../layouts/Base.astro";

const garden = loadGarden();
---

<Base title="jonpark.dev">
  <div class="home">
    <header class="title-block">
      <h1>jonpark.dev</h1>
      {/* scripts/setup-hosting.sh (HOME_PAGE_TEXT) checks for this tagline; change both together. */}
      <p>A garden of notes on what I'm learning.</p>
    </header>

    {garden.byTended.length === 0 && <p class="empty">No Notes yet.</p>}
    {
      garden.byTended.length > 0 && (
        <ol class="note-list" data-note-list aria-label="Notes, most recently tended first">
          {garden.byTended.map((note) => (
            <li>
              <span class="listed-note">
                <NoteLink note={note} />
              </span>{" "}
              <time datetime={tendedDay(note.tended)}>{tendedLong(note.tended)}</time>
            </li>
          ))}
        </ol>
      )
    }
  </div>
</Base>

<style>
  .home {
    max-width: var(--measure);
    margin: 0 auto;
    padding-top: clamp(2rem, 6vw, 3.5rem);
  }

  /* \maketitle */
  .title-block {
    text-align: center;
    margin-bottom: 2.5rem;
  }
  h1 {
    font-size: clamp(2rem, 1.4rem + 2.4vw, 2.5rem);
    font-weight: 400;
    line-height: 1.15;
    margin: 0 0 0.625rem;
  }
  .title-block p {
    margin: 0;
    font-size: 1.0625rem;
  }
  .empty {
    text-align: center;
  }

  /* Every Note, newest first: title and Stage on the left, the date flush right */
  .note-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .note-list li {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: 0 1.5rem;
    margin-bottom: 0.25rem;
  }
  .note-list :global(.stage-badge) {
    color: var(--ink);
    text-decoration-color: color-mix(in srgb, var(--ink) 30%, transparent);
    font-size: 0.875em;
    margin-left: 0.25em;
  }
  .note-list :global(time) {
    color: var(--ink-soft);
    font-size: 0.9375rem;
    white-space: nowrap;
  }

  /* Narrow screens: the date always sits on its own line, so the list stays even */
  @media (max-width: 36rem) {
    .note-list li {
      display: block;
      margin-bottom: 0.5rem;
    }
    .note-list :global(time) {
      display: block;
    }
  }
</style>
