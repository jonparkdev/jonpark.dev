---
import NoteLink from "../components/NoteLink.astro";
import StageBadge from "../components/StageBadge.astro";
import TitleBlock from "../components/TitleBlock.astro";
import { loadGarden } from "../garden/garden";
import { tendedDay, tendedLong } from "../garden/tended";
import Base from "../layouts/Base.astro";

const garden = loadGarden();
---

<Base title="jonpark.dev">
  <div class="mx-auto max-w-measure pt-page-top">
    <TitleBlock title="jonpark.dev">
      {/* scripts/setup-hosting.sh (HOME_PAGE_TEXT) checks for this tagline; change both together. */}
      <p class="text-sub text-balance">A garden of notes on what I'm learning.</p>
    </TitleBlock>

    {garden.byTended.length === 0 && <p class="my-[1em] text-center">No Notes yet.</p>}
    {
      garden.byTended.length > 0 && (
        /* Every Note, newest first: the title is the row's one link; Stage and date
           sit flush right as one quiet line of metadata.
           Wide: an unruled tabular of three columns. Long titles wrap in their own
           column; Stages align left, dates flush right, all on the first baseline.
           Narrow: Stage and date share their own line under the title. */
        <ol
          class="text-pretty sm:grid sm:grid-cols-[1fr_auto_auto] sm:gap-x-5 sm:gap-y-2"
          data-note-list
          aria-label="Notes, most recently tended first"
        >
          {garden.byTended.map((note) => (
            <li class="max-sm:mb-3 sm:col-span-full sm:grid sm:grid-cols-subgrid sm:items-baseline">
              <NoteLink note={note} badge={false} />{" "}
              <span class="text-meta whitespace-nowrap text-ink-soft max-sm:mt-0.5 max-sm:block sm:contents">
                <StageBadge stage={note.stage} linked={false} class="tracking-[0.04em] small-caps" />
                <span class="mx-[0.4em] sm:hidden" aria-hidden="true">·</span>
                <time datetime={tendedDay(note.tended)} class="sm:text-right">{tendedLong(note.tended)}</time>
              </span>
            </li>
          ))}
        </ol>
      )
    }
  </div>
</Base>
