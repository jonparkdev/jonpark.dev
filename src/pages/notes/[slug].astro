---
import type { GetStaticPaths } from "astro";
import NoteLink from "../../components/NoteLink.astro";
import { coursePath, partLabel } from "../../garden/course";
import StageBadge from "../../components/StageBadge.astro";
import { loadGarden, type Note } from "../../garden/garden";
import { stageCue } from "../../garden/stage";
import { tendedDay, tendedLong } from "../../garden/tended";
import Article from "../../layouts/Article.astro";
import Contents from "../../components/Contents.astro";

export const getStaticPaths = (() =>
  loadGarden().notes.map((note) => ({ params: { slug: note.slug }, props: { note } }))) satisfies GetStaticPaths;

interface Props {
  note: Note;
}

const { note } = Astro.props;
const hasReferences = note.linksTo.length > 0 || note.linkedFrom.length > 0;
const hasFootnotes = note.footnotes.length > 0 || note.tangents.length > 0;
---

<Article title={note.title} class="note">
  <header class="title-block">
    <h1>{note.title}</h1>
    <p class="byline">
      {note.placement && (
        <>
          <span class="sc">Topic:</span>{" "}
          <a href={`${coursePath(note.placement.course)}#${note.placement.topic.key}`}>{note.placement.topic.title}</a>
          {" · "}{partLabel(note.placement.part)}{" · "}
          <a href={coursePath(note.placement.course)}>{note.placement.course.title}</a><br />
        </>
      )}
      <span class="meta">Tended <time datetime={tendedDay(note.tended)}>{tendedLong(note.tended)}</time></span>
    </p>
  </header>

  <section class="abstract" aria-label="Stage">
    <p class="abstract-head">Stage: <StageBadge stage={note.stage} /></p>
    <p>{stageCue(note.stage)}</p>
  </section>

  <Contents items={note.headings} />

  <div class="note-body article-body flow" set:html={note.html} />

  {
    hasReferences && (
      <div class="references flow">
        <h2 class="section-rule">References</h2>
        {note.linksTo.length > 0 && (
          <section class="links-to" aria-labelledby="links-to-head">
            <h3 id="links-to-head">Links to</h3>
            <ol>
              {note.linksTo.map((target) => (
                <li>
                  <NoteLink note={target} />
                  {target.isTangent && <span class="tangent-flag"> 🐇 Tangent</span>}
                </li>
              ))}
            </ol>
          </section>
        )}
        {note.linkedFrom.length > 0 && (
          <section class="linked-from" aria-labelledby="linked-from-head">
            <h3 id="linked-from-head">Linked from</h3>
            <ol>
              {note.linkedFrom.map((source) => (
                <li>
                  <NoteLink note={source} />
                  {source.isTangent && <span class="tangent-flag"> 🐇 Tangent</span>}
                </li>
              ))}
            </ol>
          </section>
        )}
      </div>
    )
  }

  {
    hasFootnotes && (
      <footer class="footnotes" aria-labelledby="notes-head">
        <h2 id="notes-head" class="visually-hidden">
          Notes
        </h2>
        <ol>
          {note.footnotes.map((footnote) => (
            <li id={`note-${footnote.n}`}>
              <span class="fn-mark" aria-hidden="true">
                {footnote.n}
              </span>
              <Fragment set:html={footnote.html} />{" "}
              <a class="fn-back" href={`#note-ref-${footnote.n}`} aria-label={`Back to note ${footnote.n} in the text`}>
                ↑
              </a>
            </li>
          ))}
          {note.tangents.map((tangent, i) => (
            <li id={`tangent-${i + 1}`}>
              <span class="fn-mark" aria-hidden="true">
                🐇{i + 1}
              </span>
              Tangent: <NoteLink note={tangent} />{" "}
              <a class="fn-back" href={`#tangent-ref-${i + 1}`} aria-label={`Back to tangent mark ${i + 1} in the text`}>
                ↑
              </a>
            </li>
          ))}
        </ol>
      </footer>
    )
  }
</Article>

<style>
  /* The abstract's head carries the Stage */
  .abstract-head :global(.stage-badge) {
    color: var(--ink);
  }

  /* Wikilinks: hyperref colours, and LaTeX's ?? for a reference that isn't defined yet */
  .note-body :global(.unwritten) {
    color: var(--undefined);
    text-decoration: underline dashed 1px;
    text-underline-offset: 0.18em;
  }
  .note-body :global(.unwritten::after) {
    content: "??";
    content: "??" / "";
    font-size: 0.7em;
    vertical-align: super;
    line-height: 0;
    margin-left: 0.1em;
    font-weight: 700;
  }

  /* lstlisting: soft rules above and below, line numbers in the margin */
  .note-body :global(pre.listing) {
    margin-block: 2rem 2.25rem;
    padding: 0.625rem 0;
    border-top: 0.8px solid var(--rule-soft);
    border-bottom: 0.8px solid var(--rule-soft);
    overflow-x: auto;
    font-size: 0.875rem;
    line-height: 1.6;
    counter-reset: line;
    tab-size: 4;
  }
  .note-body :global(pre.listing code) {
    font-size: 1em;
  }
  .note-body :global(pre.listing .line) {
    counter-increment: line;
  }
  .note-body :global(pre.listing .line::before) {
    content: counter(line);
    display: inline-block;
    width: 2.25rem;
    padding-right: 0.875rem;
    text-align: right;
    color: var(--ink-meta);
    font-size: 0.8em;
    user-select: none;
  }

  /* booktabs: horizontal rules only, heavier at top and bottom */
  .note-body :global(table) {
    border-collapse: collapse;
    margin-block: 2rem 2.25rem;
    font-size: 1rem;
    font-variant-numeric: lining-nums tabular-nums;
    display: block;
    max-width: 100%;
    overflow-x: auto;
    width: fit-content;
  }
  .note-body :global(thead) {
    border-top: 1.5px solid var(--rule);
    border-bottom: 0.8px solid var(--rule);
  }
  .note-body :global(tbody) {
    border-bottom: 1.5px solid var(--rule);
  }
  .note-body :global(th),
  .note-body :global(td) {
    padding: 0.3rem 0.75rem;
    text-align: left;
    vertical-align: top;
  }
  .note-body :global(th) {
    font-weight: 700;
  }

  /* The bibliography: where the reader walks next.
     One counter runs straight through both lists. */
  .references {
    counter-reset: ref;
  }
  .references h2 {
    font-size: 1.375rem;
    font-weight: 700;
    line-height: 1.25;
  }
  .references h3 {
    font-size: 1rem;
    font-weight: 400;
    font-variant: small-caps;
    letter-spacing: 0.04em;
    color: var(--ink-soft);
    margin: 1.5rem 0 0.5rem;
  }
  .references ol {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .references li {
    counter-increment: ref;
    position: relative;
    padding-left: 2.5em;
    margin-bottom: 0.375rem;
  }
  .references li::before {
    content: "[" counter(ref) "]";
    position: absolute;
    left: 0;
    color: var(--ink-meta);
    font-variant-numeric: lining-nums;
  }
  .references :global(.stage-badge),
  .footnotes :global(.stage-badge) {
    color: var(--ink);
    text-decoration-color: color-mix(in srgb, var(--ink) 30%, transparent);
    font-size: 0.875em;
    margin-left: 0.25em;
  }
  .tangent-flag {
    font-size: 0.875em;
    color: var(--ink-meta);
    white-space: nowrap;
  }

  /* \footnote: a short rule, then small type. Shown only where the margin
     notes are not (see Article.astro). */
  .footnotes {
    margin-top: 4rem;
    font-size: 0.9375rem;
    color: var(--ink-soft);
  }
  .footnotes::before {
    content: "";
    display: block;
    width: 10rem;
    border-top: 0.8px solid var(--rule-soft);
    margin-bottom: 0.625rem;
  }
  .footnotes ol {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .footnotes li {
    margin-bottom: 0.375rem;
    scroll-margin-top: 1.5rem;
  }
  .footnotes li:target {
    background: var(--select);
  }
  .fn-back {
    text-decoration: none;
    margin-left: 0.25em;
  }
  .fn-mark {
    font-size: 0.75em;
    vertical-align: super;
    line-height: 0;
    margin-right: 0.25em;
    color: var(--ink-meta);
  }
</style>
