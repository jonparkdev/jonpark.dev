---
import type { GetStaticPaths } from "astro";
import Abstract from "../../components/Abstract.astro";
import NoteLink from "../../components/NoteLink.astro";
import StageBadge from "../../components/StageBadge.astro";
import TitleBlock from "../../components/TitleBlock.astro";
import { coursePath, partLabel } from "../../garden/course";
import { loadGarden, type Note } from "../../garden/garden";
import { stageCue } from "../../garden/stage";
import { tendedDay, tendedLong } from "../../garden/tended";
import Article from "../../layouts/Article.astro";

export const getStaticPaths = (() =>
  loadGarden().notes.map((note) => ({ params: { slug: note.slug }, props: { note } }))) satisfies GetStaticPaths;

interface Props {
  note: Note;
}

const { note } = Astro.props;

const hasReferences = note.linksTo.length > 0 || note.linkedFrom.length > 0;

// The bibliography's list heads: small caps, like \section* in a short article.
const referencesHead = "mt-5 mb-1.5 text-base font-normal tracking-[0.04em] small-caps";
// One bibliography, numbered [1], [2], … straight through both lists.
const referenceItem =
  "relative mb-1 pl-[2.5em] [counter-increment:ref] before:absolute before:left-0 before:content-['['_counter(ref)_']']";
const tangentFlag = "text-[0.875em] whitespace-nowrap";
---

<Article title={note.title} class="note">
  <TitleBlock title={note.title} article>
    <p class="text-sub leading-normal">
      {
        note.placement && (
          <>
            <span class="tracking-[0.03em] small-caps">Topic:</span>{" "}
            <a href={`${coursePath(note.placement.course)}#${note.placement.topic.key}`}>{note.placement.topic.title}</a>
            {" · "}{partLabel(note.placement.part)}{" · "}
            <a href={coursePath(note.placement.course)}>{note.placement.course.title}</a><br />
          </>
        )
      }
      Tended <time datetime={tendedDay(note.tended)}>{tendedLong(note.tended)}</time>
    </p>
  </TitleBlock>

  <Abstract label="Stage">
    <Fragment slot="head">Stage: <StageBadge stage={note.stage} class="text-ink" /></Fragment>
    <p>{stageCue(note.stage)}</p>
  </Abstract>

  <div class="note-body article-body" set:html={note.html} />

  {
    hasReferences && (
      <div class="mt-12 [counter-reset:ref]">
        <h2 class="mb-3 text-section font-bold">References</h2>
        {note.linksTo.length > 0 && (
          <section class="links-to" aria-labelledby="links-to-head">
            <h3 id="links-to-head" class={referencesHead}>
              Links to
            </h3>
            <ol>
              {note.linksTo.map((target) => (
                <li class={referenceItem}>
                  <NoteLink note={target} />
                  {target.isTangent && <span class={tangentFlag}> 🐇 Tangent</span>}
                </li>
              ))}
            </ol>
          </section>
        )}
        {note.linkedFrom.length > 0 && (
          <section class="linked-from" aria-labelledby="linked-from-head">
            <h3 id="linked-from-head" class={referencesHead}>
              Linked from
            </h3>
            <ol>
              {note.linkedFrom.map((source) => (
                <li class={referenceItem}>
                  <NoteLink note={source} />
                  {source.isTangent && <span class={tangentFlag}> 🐇 Tangent</span>}
                </li>
              ))}
            </ol>
          </section>
        )}
      </div>
    )
  }

  {
    note.tangents.length > 0 && (
      /* \footnote: a short rule, then small type */
      <footer
        class="mt-12 text-meta before:mb-2 before:block before:w-40 before:border-t-[0.8px] before:border-rule"
        aria-labelledby="tangents-head"
      >
        <h2 id="tangents-head" class="sr-only">
          Tangents
        </h2>
        <ol>
          {note.tangents.map((tangent, i) => (
            <li id={`tangent-${i + 1}`} class="mb-1 target:bg-select">
              <span class="mr-[0.25em] align-super text-[0.75em] leading-0" aria-hidden="true">
                🐇{i + 1}
              </span>
              Tangent: <NoteLink note={tangent} />{" "}
              <a
                class="ml-[0.25em] no-underline"
                href={`#tangent-ref-${i + 1}`}
                aria-label={`Back to tangent mark ${i + 1} in the text`}
              >
                ↑
              </a>
            </li>
          ))}
        </ol>
      </footer>
    )
  }
</Article>
