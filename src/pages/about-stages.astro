---
import { STAGES, stageEmoji, stageLabel, type Stage } from "../garden/stage";
import Article from "../layouts/Article.astro";

// What each Stage says about my understanding, and what I had to do to earn it.
const stageRows: Record<Stage, { means: string; earnedBy: string }> = {
  seedling: {
    means: "“I’m thinking about this.” Expect gaps and mistakes.",
    earnedBy: "Written from memory with the source closed, soon after first learning the idea.",
  },
  budding: {
    means: "“I understand the core idea.”",
    earnedBy: "Explained again from memory on a different day, then checked and corrected against the source.",
  },
  evergreen: {
    means: "“I can use this.” Stable, but never finished.",
    earnedBy: "Applied in a mock interview, a design problem, or an explainer video.",
  },
};

const ladderLabel =
  "Recall moves a Note up one Stage, from Seedling to Budding to Evergreen. Demotion moves it back one Stage.";
---

<Article title="About Stages">
  <header class="title-block">
    <h1>About Stages</h1>
  </header>

  <section class="abstract" aria-label="Abstract">
    <p class="abstract-head">Abstract</p>
    <p>
      Every Note in this garden carries a Stage: an honest mark of how well I understand the idea right now,
      not of how polished the writing is.
    </p>
  </section>

  <div class="article-body">
    <h2 id="the-stages">The Stages</h2>
    <table class="stage-table">
      <caption><span class="sc">Table 1</span>&ensp;The Stages, from least to most understood</caption>
      <thead>
        <tr>
          <th scope="col">Stage</th>
          <th scope="col">Means</th>
          <th scope="col">Earned by</th>
        </tr>
      </thead>
      <tbody>
        {
          STAGES.map((stage) => (
            <tr>
              <th scope="row" id={stage}>
                <span aria-hidden="true">{stageEmoji(stage)}</span> {stageLabel(stage)}
              </th>
              <td data-label="Means">{stageRows[stage].means}</td>
              <td data-label="Earned by">{stageRows[stage].earnedBy}</td>
            </tr>
          ))
        }
      </tbody>
    </table>

    <h2 id="how-stages-change">How Stages change</h2>
    <p>
      A Note moves up a Stage only through <strong>Recall</strong>: explaining the idea from memory with the
      source closed. Editing, tidying or adding pictures never changes a Stage.
    </p>

    <figure class="ladder">
      <div class="ladder-track" role="img" aria-label={ladderLabel}>
        {
          STAGES.map((stage, i) => (
            <>
              {i > 0 && (
                <span class="step">
                  <span class="step-up">
                    Recall
                    <svg viewBox="0 0 48 8" width="48" height="8">
                      <path d="M0 4H46.5M41.5 1l5 3-5 3" />
                    </svg>
                  </span>
                  <span class="step-down">
                    <svg viewBox="0 0 48 8" width="48" height="8">
                      <path d="M48 4H1.5M6.5 1l-5 3 5 3" />
                    </svg>
                    Demotion
                  </span>
                </span>
              )}
              <span class="rung">
                {stageEmoji(stage)} {stageLabel(stage)}
              </span>
            </>
          ))
        }
      </div>
      <figcaption><span class="sc">Figure 1</span>&ensp;How a Note changes Stage</figcaption>
    </figure>

    <p>
      When a Recall goes badly, the Note moves back a Stage. That <strong>Demotion</strong> is expected, not a
      failure, and the reason is written down. So a Seedling here is an honest snapshot, not an unfinished page.
    </p>

    <h2 id="tangents"><span aria-hidden="true">🐇</span> Tangents</h2>
    <p>
      Each Course I follow, such as <a href="/hellointerview">Hello Interview</a>, has a syllabus of Topics.
      A <strong>Tangent</strong> is a Topic I added that isn’t in the syllabus, reached by following a rabbit hole
      from a Topic that is. Each Course’s page lists its Tangents last, under <span class="nowrap">🐇 Tangents</span>.
    </p>
    <p>
      When a Note in a syllabus Topic links to a Tangent, the link gets a numbered 🐇 mark, and the Tangent is named in a footnote at
      the end of the Note, so the main thread stays easy to follow.
    </p>
  </div>
</Article>

<style>
  .nowrap {
    white-space: nowrap;
  }

  /* Table 1: booktabs, caption above as LaTeX sets it */
  .stage-table {
    width: 100%;
    border-collapse: collapse;
    margin: 1.25rem 0 1.5rem;
    font-size: 1rem;
    line-height: 1.5;
  }
  .stage-table caption {
    caption-side: top;
    text-align: center;
    font-size: 0.9375rem;
    margin-bottom: 0.625rem;
  }
  .stage-table thead {
    border-top: 1.5px solid var(--rule);
    border-bottom: 0.8px solid var(--rule);
  }
  .stage-table tbody {
    border-bottom: 1.5px solid var(--rule);
  }
  .stage-table th,
  .stage-table td {
    padding: 0.45rem 0.75rem;
    text-align: left;
    vertical-align: top;
    hyphens: auto;
    -webkit-hyphens: auto;
  }
  .stage-table th:first-child,
  .stage-table td:first-child {
    padding-left: 0;
  }
  .stage-table th:last-child,
  .stage-table td:last-child {
    padding-right: 0;
  }
  .stage-table tbody tr:first-child > * {
    padding-top: 0.625rem;
  }
  .stage-table tbody tr:last-child > * {
    padding-bottom: 0.625rem;
  }
  .stage-table tbody th {
    white-space: nowrap;
    padding-right: 1.25rem;
    scroll-margin-top: 2rem;
  }
  .stage-table td:nth-child(2) {
    width: 38%;
  }
  /* Arriving from a Stage badge marks the row you came for */
  .stage-table tr:has(th:target) > * {
    background: var(--select);
  }

  /* Figure 1: the Stage ladder */
  .ladder {
    container: ladder / inline-size;
    margin: 1.75rem 0 1.5rem;
    text-align: center;
  }
  .ladder-track {
    display: inline-grid;
    grid-auto-flow: column;
    align-items: center;
    column-gap: 0.875rem;
  }
  .rung {
    font-weight: 700;
    white-space: nowrap;
  }
  .step {
    display: grid;
    row-gap: 0.125rem;
    font-size: 0.9375rem;
    font-variant: small-caps;
    letter-spacing: 0.03em;
    line-height: 1.2;
  }
  .step-up,
  .step-down {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.375rem;
  }
  .step svg {
    display: block;
    flex: none;
  }
  .step path {
    fill: none;
    stroke: currentColor;
    stroke-width: 0.9;
  }
  .ladder figcaption {
    margin-top: 0.875rem;
    font-size: 0.9375rem;
  }

  @media (max-width: 36rem) {
    /* Table 1 restacks: one block per Stage, its columns labelled inline */
    .stage-table,
    .stage-table tbody,
    .stage-table tr,
    .stage-table th,
    .stage-table td {
      display: block;
    }
    .stage-table thead {
      display: none;
    }
    .stage-table tbody {
      border-top: 1.5px solid var(--rule);
    }
    .stage-table caption {
      display: block;
    }
    .stage-table tr {
      padding: 0.75rem 0;
    }
    .stage-table tr + tr {
      border-top: 0.8px solid var(--rule);
    }
    .stage-table th,
    .stage-table td,
    .stage-table tbody tr:first-child > *,
    .stage-table tbody tr:last-child > * {
      padding: 0;
    }
    .stage-table td:nth-child(2) {
      width: auto;
    }
    .stage-table tbody th {
      margin-bottom: 0.25rem;
    }
    .stage-table td + td {
      margin-top: 0.25rem;
    }
    .stage-table td::before {
      content: attr(data-label) " ";
      font-variant: small-caps;
      letter-spacing: 0.03em;
      font-weight: 700;
    }
    .stage-table tr:has(th:target) {
      background: var(--select);
    }
    .stage-table tr:has(th:target) > * {
      background: none;
    }
  }

  /* Figure 1 turns vertical once its column is too narrow for the row */
  @container ladder (max-width: 38rem) {
    /* Recall reads downward, Demotion upward */
    .ladder-track {
      grid-auto-flow: row;
      row-gap: 0.5rem;
    }
    .step {
      grid-auto-flow: column;
      column-gap: 1.25rem;
    }
    .step svg {
      transform: rotate(90deg);
      width: 1.25rem;
      height: auto;
    }
    .step-up {
      flex-direction: row;
    }
  }
</style>
