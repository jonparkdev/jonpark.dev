---
import Abstract from "../components/Abstract.astro";
import TitleBlock from "../components/TitleBlock.astro";
import { STAGES, stageEmoji, stageLabel, type Stage } from "../garden/stage";
import Article from "../layouts/Article.astro";

// What each Stage says about my understanding, and what I had to do to earn it.
const stageRows: Record<Stage, { means: string; earnedBy: string }> = {
  seedling: {
    means: "“I’m thinking about this.” Expect gaps and mistakes.",
    earnedBy: "Written from memory with the source closed, soon after first learning the idea.",
  },
  budding: {
    means: "“I understand the core idea.”",
    earnedBy: "Explained again from memory on a different day, then checked and corrected against the source.",
  },
  evergreen: {
    means: "“I can use this.” Stable, but never finished.",
    earnedBy: "Applied in a mock interview, a design problem, or an explainer video.",
  },
};

const ladderLabel =
  "Recall moves a Note up one Stage, from Seedling to Budding to Evergreen. Demotion moves it back one Stage.";

// Table 1 is booktabs: horizontal rules only, heavier at top and bottom, cells
// flush with the table's edges. On a phone it restacks into one block per
// Stage, each column labelled inline.
const headCell = "px-3 py-[0.45rem] text-left align-top hyphens-auto first:pl-0 last:pr-0";
const rowHead =
  "scroll-mt-8 py-[0.45rem] pr-5 pl-0 text-left align-top whitespace-nowrap hyphens-auto max-sm:mb-1 max-sm:block max-sm:p-0";
const cell =
  "px-3 py-[0.45rem] align-top hyphens-auto last:pr-0 max-sm:block max-sm:p-0 " +
  "max-sm:before:font-bold max-sm:before:tracking-[0.03em] max-sm:before:small-caps max-sm:before:content-[attr(data-label)_'_']";
// Arriving from a Stage badge marks the row you came for.
const row =
  "sm:first:*:pt-2.5 sm:last:*:pb-2.5 sm:has-[th:target]:*:bg-select " +
  "max-sm:block max-sm:py-3 max-sm:not-first:border-t-[0.8px] max-sm:not-first:border-rule max-sm:has-[th:target]:bg-select";

// Figure 1 turns vertical once its column (the "ladder" container) is too
// narrow for the row: Recall then reads downward, Demotion upward.
// Class names are written out in full so Tailwind's scanner finds them.
const track =
  "inline-grid grid-flow-col items-center gap-x-3.5 @max-[38rem]/ladder:grid-flow-row @max-[38rem]/ladder:gap-y-2";
const step =
  "grid gap-y-0.5 text-meta leading-[1.2] tracking-[0.03em] small-caps @max-[38rem]/ladder:grid-flow-col @max-[38rem]/ladder:gap-x-5";
const arrow = "block flex-none @max-[38rem]/ladder:h-auto @max-[38rem]/ladder:w-5 @max-[38rem]/ladder:rotate-90";
---

<Article title="About Stages">
  <TitleBlock title="About Stages" article />

  <Abstract label="Abstract">
    <p>
      Every Note in this garden carries a Stage: an honest mark of how well I understand the idea right now,
      not of how polished the writing is.
    </p>
  </Abstract>

  <div class="article-body">
    <h2 id="the-stages">The Stages</h2>
    <table class="mt-5 mb-6 w-full text-base leading-normal max-sm:block">
      <caption class="mb-2.5 caption-top text-center text-meta max-sm:block">
        <span class="tracking-[0.03em] small-caps">Table 1</span>&ensp;The Stages, from least to most understood
      </caption>
      <thead class="border-t-[1.5px] border-b-[0.8px] border-rule max-sm:hidden">
        <tr>
          <th scope="col" class={headCell}>Stage</th>
          <th scope="col" class={headCell}>Means</th>
          <th scope="col" class={headCell}>Earned by</th>
        </tr>
      </thead>
      <tbody class="border-b-[1.5px] border-rule max-sm:block max-sm:border-t-[1.5px]">
        {
          STAGES.map((stage) => (
            <tr class={row}>
              <th scope="row" id={stage} class={rowHead}>
                <span aria-hidden="true">{stageEmoji(stage)}</span> {stageLabel(stage)}
              </th>
              <td data-label="Means" class:list={[cell, "w-[38%] max-sm:w-auto"]}>{stageRows[stage].means}</td>
              <td data-label="Earned by" class:list={[cell, "max-sm:mt-1"]}>{stageRows[stage].earnedBy}</td>
            </tr>
          ))
        }
      </tbody>
    </table>

    <h2 id="how-stages-change">How Stages change</h2>
    <p>
      A Note moves up a Stage only through <strong>Recall</strong>: explaining the idea from memory with the
      source closed. Editing, tidying or adding pictures never changes a Stage.
    </p>

    <figure class="@container/ladder mt-7 mb-6 text-center">
      <div class={track} role="img" aria-label={ladderLabel}>
        {
          STAGES.map((stage, i) => (
            <>
              {i > 0 && (
                <span class={step}>
                  <span class="flex items-center justify-center gap-1.5">
                    Recall
                    <svg viewBox="0 0 48 8" width="48" height="8" class={arrow}>
                      <path d="M0 4H46.5M41.5 1l5 3-5 3" class="fill-none stroke-current stroke-[0.9]" />
                    </svg>
                  </span>
                  <span class="flex items-center justify-center gap-1.5">
                    <svg viewBox="0 0 48 8" width="48" height="8" class={arrow}>
                      <path d="M48 4H1.5M6.5 1l-5 3 5 3" class="fill-none stroke-current stroke-[0.9]" />
                    </svg>
                    Demotion
                  </span>
                </span>
              )}
              <span class="font-bold whitespace-nowrap">
                {stageEmoji(stage)} {stageLabel(stage)}
              </span>
            </>
          ))
        }
      </div>
      <figcaption class="mt-3.5 text-meta">
        <span class="tracking-[0.03em] small-caps">Figure 1</span>&ensp;How a Note changes Stage
      </figcaption>
    </figure>

    <p>
      When a Recall goes badly, the Note moves back a Stage. That <strong>Demotion</strong> is expected, not a
      failure, and the reason is written down. So a Seedling here is an honest snapshot, not an unfinished page.
    </p>

    <h2 id="tangents"><span aria-hidden="true">🐇</span> Tangents</h2>
    <p>
      Each Course I follow, such as <a href="/hellointerview">Hello Interview</a>, has a syllabus of Topics.
      A <strong>Tangent</strong> is a Topic I added that isn’t in the syllabus, reached by following a rabbit hole
      from a Topic that is. Each Course’s page lists its Tangents last, under <span class="whitespace-nowrap">🐇 Tangents</span>.
    </p>
    <p>
      When a Note in a syllabus Topic links to a Tangent, the link gets a numbered 🐇 mark, and the Tangent is named in a footnote at
      the end of the Note, so the main thread stays easy to follow.
    </p>
  </div>
</Article>
